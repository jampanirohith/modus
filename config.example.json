{
  "spotify": {
    "client_id": "YOUR_SPOTIFY_CLIENT_ID",
    "client_secret": "YOUR_SPOTIFY_CLIENT_SECRET",
    "redirect_uri": "http://127.0.0.1:8888/callback",
    "playlist_id": "YOUR_PLAYLIST_ID",
    "scope": "playlist-read-private playlist-read-collaborative"
  },
  "genius": {"access_token": "YOUR_GENIUS_TOKEN"},
  "paths": {"db_dir": "db", "temp_dir": "temp", "songs_dir": "songs"},
  "processing": {
    "device": "cuda",
    "demucs_model": "htdemucs",
    "whisper_model": "openai/whisper-tiny",
    "mms_model": "facebook/mms-1b-all",
    "vad_threshold": 0.5,
    "validation_similarity": 0.80,
    "mms_confidence": 0.60,
    "max_segment_seconds": 20.0,
    "min_segment_seconds": 4.0,
    "pause_cut_seconds": 1.5,
    "large_gap_seconds": 3.0,
    "large_buffer_seconds": 2.0,
    "medium_buffer_seconds": 1.0,
    "tiny_buffer_seconds": 0.3
  }
}
