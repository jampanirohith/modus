{
  "project": {
    "pipeline_version": "1.3.0",
    "phase2_json_schema_version": 2
  },
  "paths": {
    "original_dir": "songs/original",
    "final_dir": "songs/final",
    "temp_dir": "temp",
    "db_dir": "db",
    "models_dir": "models/mms"
  },
  "models": {
    "mms_model": "facebook/mms-1b-all",
    "mms_revision": null,
    "language_iso1": "te",
    "language_iso3": "tel",
    "demucs_model": "htdemucs",
    "allow_download": true
  },
  "audio": {
    "sample_rate": 16000,
    "minimum_duration_ms": 5000
  },
  "demucs": {
    "segment_seconds": 8,
    "retry_segment_seconds": 8
  },
  "vad": {
    "enabled": true,
    "threshold": 0.5,
    "min_speech_duration_ms": 250,
    "min_silence_duration_ms": 300,
    "speech_pad_ms": 150,
    "energy_threshold_db": -38.0
  },
  "chunking": {
    "min_seconds": 4.0,
    "target_seconds": 12.0,
    "max_seconds": 20.0,
    "context_before_ms": 500,
    "context_after_ms": 500,
    "pause_threshold_ms": 1500,
    "large_gap_threshold_ms": 3000
  },
  "alignment": {
    "chunk_mean_score_min": 0.4,
    "min_word_score": 0.4,
    "anchor_search_ms": 2500,
    "fallback_to_original_mix": true,
    "max_global_repair_ms": 1500,
    "retry_context_extra_ms": 500,
    "global_retry_max_chunks": 6,
    "global_retry_attempts_per_chunk": 2,
    "reject_lyric_crossing_blank_marker": true,
    "final_timing_repair_max_ms": 5000,
    "final_timing_repair_enabled": true
  },
  "instrumental": {
    "minimum_gap_ms": 1500
  },
  "validation": {
    "anchor_warn_ms": 2500,
    "min_word_duration_ms": 30,
    "max_word_duration_ms": 5000
  },
  "normalization": {
    "version": "1.1.0",
    "keep_latin": true,
    "keep_digits": true,
    "convert_numbers_to_telugu": false,
    "expand_abbreviations": true,
    "remove_punctuation": true,
    "abbreviations": {
      "Sr.": "శ్రీ",
      "Smt.": "శ్రీమతి",
      "Sri.": "శ్రీ"
    }
  },
  "runtime": {
    "device": "cuda",
    "fallback_device": "cpu",
    "require_cuda": true,
    "allow_cpu_fallback": false,
    "print_device_banner": true
  },
  "models_runtime": {
    "torch_inference_mode": true
  },
  "recovery": {
    "stale_after_minutes": 30,
    "max_chunk_attempts": 2,
    "max_song_attempts": 3
  }
}
